\def\:tempa#1#2{%
   \def\:tempc##1{%
     \def\:temp{%
       \ifx #1\next \let\next^%
                    \def\:temp########1{##1^}%
       \else
          \ifx #2\next \let\next_%
                       \def\:temp########1{##1_}%
          \else  \let\:temp##1\fi
       \fi
       \:temp}\futurelet\next\:temp}%
   }

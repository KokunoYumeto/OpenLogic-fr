% Le lecteur complet expose les variantes, tout en permettant leur sélection
% usuelle lorsqu'une section est réutilisée dans un autre cours.
\newif\iffrcompletevariants
\long\def\frproofversions#1#2#3#4#5{%
  \iffrcompletevariants
    \par\medskip\noindent\emph{#1}\par\nobreak #4%
    \par\medskip\noindent\emph{#2}\par\nobreak #5%
  \else\oliflabeldef{#3}{#4}{#5}\fi}
\renewcommand{\TAss}{Hypothèse}

% Sur papier, placer la notice sur la page de titre de la partie.
\newbox\OLPartNoticeBox
\NewDocumentEnvironment{OLPartNotice}{m}{%
  \ifdefined\HCode
    #1%
  \else
    \def\OLPartNoticeHeading{#1}%
    \setbox\OLPartNoticeBox=\vbox\bgroup
  \fi
}{%
  \ifdefined\HCode\else
    \egroup
    \let\OLPartNoticeAfterSkip\afterpartskip
    \renewcommand*{\afterpartskip}{%
      \ifdim\ht\OLPartNoticeBox>0pt\relax
        \par\bigskip\unvbox\OLPartNoticeBox
      \fi
      \OLPartNoticeAfterSkip
    }%
    \OLPartNoticeHeading
  \fi
}
